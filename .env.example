# Application Settings
APP_NAME=PDFCon - Government Financial Report Analysis System
APP_VERSION=1.0.0
DEBUG=false
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pdfcon
DATABASE_TEST_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pdfcon_test
MONGODB_URL=mongodb://localhost:27017/pdfcon

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CELERY_DB=1

# Security
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# File Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES=["application/pdf"]

# MinIO/S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=pdfcon-documents

# AI/ML
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.3
CEREBRAS_API_KEY=csk-f2n925vrhd2rc6f4e98xnpwx4pt2hnjx3k38xrpf89yjytv6

# Web Scraping
PLAYWRIGHT_HEADLESS=true
SELENIUM_HEADLESS=true
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Task Processing
MAX_WORKERS=4
TASK_TIMEOUT=3600

# Report Settings
REPORT_CACHE_TTL=86400
MAX_REPORT_AGE_DAYS=30

# API Configuration
API_PROVIDER=cerebras  # or 'openai'
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1